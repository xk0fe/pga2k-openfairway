<Project Sdk="Microsoft.NET.Sdk">
  <!-- .NET Framework 4.8 ships with Windows 10/11, so the launcher needs nothing installed and stays tiny. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>OpenFairway</AssemblyName>
    <RootNamespace>OpenFairway.Launcher</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- The same version as the platform it ships with (src/OpenFairway.Core). -->
    <Version>0.5.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>
  <ItemGroup>
    <!-- The turning golf hole, rendered by tools/render-hole.py. -->
    <EmbeddedResource Include="Assets\hole.bin" LogicalName="OpenFairway.Launcher.hole.bin" />
    <!-- What's new, when GitHub cannot be reached. -->
    <EmbeddedResource Include="..\..\CHANGELOG.md" LogicalName="OpenFairway.Launcher.CHANGELOG.md" />
  </ItemGroup>
</Project>
