<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>OpenFairway.Core</RootNamespace>
    <Version>0.6.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\OpenFairway.API\OpenFairway.API.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The games OpenFairway runs in, shared with the launcher and the installer. -->
    <Compile Include="..\Shared\GameEdition.cs" Link="Shared\GameEdition.cs" />
    <EmbeddedResource Include="..\Shared\games.json" LogicalName="OpenFairway.games.json" />
  </ItemGroup>
</Project>
